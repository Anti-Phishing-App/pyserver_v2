# 프로젝트 루트에 복사:  cp .env.example .env  후 값 입력. .env 는 Git 에 올리지 마세요.
# Docker Compose 는 이 디렉터리의 .env 를 읽어 ai_server 컨테이너로 전달합니다.
# 로컬에서 ai_server 만 실행할 때는 동일 내용을 ai_server/.env 에 두어도 됩니다.

# ---- CLOVA Speech · 장문 인식 (REST, /recognizer/upload 등) ----
CLOVA_SPEECH_LONGFORM_INVOKE_URL=
CLOVA_SPEECH_LONGFORM_SECRET_KEY=

# ---- CLOVA Speech · 실시간 스트리밍 (gRPC NestService) ----
CLOVA_SPEECH_STREAMING_SECRET_KEY=
# 선택. 비우면 gRPC 클라이언트 기본 호스트/포트 사용 (NCP 안내와 동일하게 쓸 경우에만 설정)
# CLOVA_SPEECH_STREAMING_GRPC_TARGET=clovaspeech-gw.ncloud.com:50051

# ---- (선택) 예전 이름 — 위 전용 변수가 비어 있을 때만 대체
# CLOVA_INVOKE_URL=
# CLOVA_SECRET_KEY=

# ---- OCR 등(ai_server · ocr_predictor) 다른 엔드포인트 쓰는 경우 ----
# CLOVA_API_URL=
# CLOVA_SECRET_KEY2=

# ---- Voice phishing ML backend (CALL) ----
# tfidf_rf | koelectra
PHONE_ML_BACKEND=koelectra
# KoELECTRA model directory (from_pretrained format)
PHONE_KE_MODEL_DIR=./model/call(KE)/call_koelectra_model_v3_imbalance_r5_r5_ext_v1_scale12000_aug
# threshold on phishing probability (0~1)
PHONE_ML_THRESHOLD=0.01
